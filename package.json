{
  "name": "crucix",
  "version": "2.2.0",
  "description": "Local intelligence engine - 54 OSINT sources, live dashboard, public demo at crucix.live, auto-refresh, optional LLM layer.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --trace-warnings server.mjs",
    "sweep": "node apis/briefing.mjs",
    "inject": "node dashboard/inject.mjs",
    "brief": "node apis/briefing.mjs",
    "brief:save": "node apis/save-briefing.mjs",
    "diag": "node diag.mjs",
    "clean": "node scripts/clean.mjs",
    "fresh-start": "npm run clean && npm start",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --suite=unit",
    "test:integration": "node scripts/run-tests.mjs --suite=integration",
    "test:e2e": "node scripts/run-tests.mjs --suite=e2e",
    "test:report": "node scripts/run-tests.mjs --report"
  },
  "keywords": [
    "osint",
    "intelligence",
    "dashboard",
    "geopolitical"
  ],
  "author": "Crucix",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.1.0"
  },
  "optionalDependencies": {
    "discord.js": "14.27.0"
  },
  "overrides": {
    "undici": "^7.30.0",
    "ws": "^8.21.0",
    "qs": "^6.15.2",
    "path-to-regexp": "^8.4.0",
    "body-parser": "^2.3.0"
  }
}
